@page "/auditoria"
@rendermode InteractiveServer
@attribute [Authorize(Roles = $"{Roles.Jefatura},{Roles.Administrador}")]
@inject ServicioAuditoria Auditoria
@inject ServicioUsuarios Usuarios

<PageTitle>Auditoría · Evaluación Fomento</PageTitle>

<h1 class="h3 mb-1">Registro de auditoría</h1>
<p class="text-muted small">
    Acciones de usuarios y robots (tabla AUDITORIA). El registro es de solo inserción: no se puede modificar ni borrar, ni desde la
    aplicación ni desde la base de datos.
</p>

<div class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label small mb-0" for="au-desde">Desde</label>
        <input id="au-desde" type="date" class="form-control form-control-sm" @bind="_desde" @bind:after="Buscar" />
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="au-hasta">Hasta</label>
        <input id="au-hasta" type="date" class="form-control form-control-sm" @bind="_hasta" @bind:after="Buscar" />
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="au-accion">Acción</label>
        <select id="au-accion" class="form-select form-select-sm" @bind="_accion" @bind:after="Buscar">
            <option value="">Todas</option>
            @foreach (var a in _acciones) { <option value="@a">@a</option> }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="au-autor">Autor</label>
        <select id="au-autor" class="form-select form-select-sm" @bind="_autor" @bind:after="Buscar">
            <option value="">Todos</option>
            @foreach (var (id, nombre) in _nombres.OrderBy(n => n.Value)) { <option value="@id">@nombre</option> }
            @foreach (var r in _robots) { <option value="@r">@r (robot)</option> }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="au-nro">Evaluación</label>
        <input id="au-nro" class="form-control form-control-sm" placeholder="COP-2026-0001" @bind="_nro" @bind:event="oninput" @bind:after="Buscar" />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary btn-sm" @onclick="Limpiar">Limpiar filtros</button>
    </div>
</div>

<p class="small text-muted mb-1">@ResumenLista</p>
<Paginador Pagina="_pagina.Pagina" Paginas="_pagina.Paginas" Cambio="IrA" />
<table class="table table-sm tabla-compacta align-middle">
    <thead><tr><th>Fecha</th><th>Autor</th><th>Acción</th><th>Evaluación</th><th>Detalle</th></tr></thead>
    <tbody>
        @foreach (var a in _pagina.Filas)
        {
            <tr>
                <td class="text-nowrap">@a.Fecha.ToString("dd-MM-yyyy HH:mm:ss")</td>
                <td>@(a.Robot ?? (a.IdUsuario is int id ? _nombres.GetValueOrDefault(id, $"Usuario {id}") : "—"))</td>
                <td><code>@a.Accion</code></td>
                <td>@if (a.IdSolicitud is long s) { <a href="evaluaciones/@s">#@s</a> }</td>
                <td class="small">@a.Detalle</td>
            </tr>
        }
    </tbody>
</table>
<Paginador Pagina="_pagina.Pagina" Paginas="_pagina.Paginas" Cambio="IrA" />

@code {
    private Dictionary<int, string> _nombres = [];
    private IReadOnlyList<string> _acciones = [], _robots = [];
    private PaginaAuditoria _pagina = new([], 0, 1, PaginaAuditoria.TamanoPorDefecto);
    private DateTime? _desde, _hasta;
    private string _accion = "", _autor = "", _nro = "";

    protected override void OnInitialized()
    {
        _nombres = Usuarios.Listar().ToDictionary(u => u.Id, u => u.NombreCompleto);
        (_acciones, _robots) = Auditoria.Catalogo();
        Buscar();
    }

    private string ResumenLista => _pagina.Total switch
    {
        0 => "No hay acciones que coincidan.",
        1 => "1 acción.",
        _ when _pagina.Paginas == 1 => $"{_pagina.Total:N0} acciones.",
        _ => $"{_pagina.Total:N0} acciones; se muestran de la {(_pagina.Pagina - 1) * _pagina.TamanoPagina + 1:N0} a la " +
             $"{(_pagina.Pagina - 1) * _pagina.TamanoPagina + _pagina.Filas.Count:N0}, las más recientes primero."
    };

    /// <summary>Al cambiar un filtro se vuelve a la primera página.</summary>
    private void Buscar() => IrA(1);

    private void IrA(int pagina) => _pagina = Auditoria.Paginar(_desde, _hasta, _accion, _autor, _nro, pagina);

    private void Limpiar()
    {
        (_desde, _hasta, _accion, _autor, _nro) = (null, null, "", "", "");
        Buscar();
    }
}
