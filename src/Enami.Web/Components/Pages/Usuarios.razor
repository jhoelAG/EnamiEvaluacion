@page "/usuarios"
@rendermode InteractiveServer
@attribute [Authorize(Roles = Roles.Administrador)]
@inject ServicioUsuarios Servicio
@inject ServicioCatalogos Catalogos

<PageTitle>Usuarios · Evaluación Fomento</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Usuarios</h1>
    <button class="btn btn-primary btn-sm" @onclick="Nuevo">Nuevo usuario</button>
</div>

@if (_mensaje is not null)
{
    <div class="alert @_claseMensaje py-2" role="status">@_mensaje</div>
}

@if (_editando)
{
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h6 mb-3">@(_idEdicion is null ? "Nuevo usuario" : "Editar usuario")</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="u-nombre">Nombre completo</label>
                    <input id="u-nombre" class="form-control" @bind="_datos.NombreCompleto" maxlength="120" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="u-correo">Correo institucional</label>
                    <input id="u-correo" type="email" class="form-control" @bind="_datos.Correo" maxlength="120" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="u-rol">Rol</label>
                    <select id="u-rol" class="form-select" @bind="_datos.Rol">
                        @foreach (var r in Roles.Todos)
                        {
                            <option value="@r">@Roles.Nombre(r)</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="u-oficina">Oficina</label>
                    <select id="u-oficina" class="form-select" @bind="_datos.IdOficina" disabled="@(!Roles.RequiereOficina(_datos.Rol))">
                        <option value="">@(Roles.RequiereOficina(_datos.Rol) ? "Seleccione…" : "Alcance nacional")</option>
                        @foreach (var o in _oficinas)
                        {
                            <option value="@o.Id">@o.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="u-clave">@(_idEdicion is null ? "Contraseña inicial" : "Nueva contraseña (opcional)")</label>
                    <input id="u-clave" type="password" class="form-control" @bind="_datos.Clave" autocomplete="new-password" />
                    <div class="form-text">Mínimo @ServicioUsuarios.LargoMinimoClave caracteres, con letras y números.</div>
                </div>
            </div>
            <div class="mt-3">
                <button class="btn btn-primary" @onclick="Guardar">Guardar</button>
                <button class="btn btn-outline-secondary ms-2" @onclick="() => _editando = false">Cancelar</button>
            </div>
        </div>
    </div>
}

<div class="row g-2 mb-2">
    <div class="col-md-4">
        <input class="form-control form-control-sm" placeholder="Buscar por nombre o correo" @bind="_filtro" @bind:event="oninput" />
    </div>
</div>

<table class="table table-sm tabla-compacta align-middle">
    <thead>
        <tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Oficina</th><th>Estado</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var u in Filtrados)
        {
            <tr class="@(u.Activo ? "" : "text-muted")">
                <td>@u.NombreCompleto</td>
                <td>@u.Correo</td>
                <td>@Roles.Nombre(u.Rol)</td>
                <td>@(u.Oficina ?? "—")</td>
                <td>
                    @if (u.Activo) { <span class="badge text-bg-success">Habilitado</span> }
                    else { <span class="badge text-bg-secondary">Deshabilitado</span> }
                </td>
                <td class="text-end text-nowrap">
                    <button class="btn btn-link btn-sm" @onclick="() => Editar(u)">Editar</button>
                    @if (u.Id != _yo?.Id)
                    {
                        <button class="btn btn-link btn-sm @(u.Activo ? "text-danger" : "")" @onclick="() => CambiarEstado(u)">@(u.Activo ? "Deshabilitar" : "Habilitar")</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
<p class="small text-muted">Los usuarios no se eliminan para conservar la trazabilidad de sus acciones; un usuario deshabilitado no puede ingresar y pierde la sesión abierta en menos de un minuto.</p>

@code {
    [CascadingParameter] private Task<AuthenticationState> Estado { get; set; } = default!;
    private UsuarioSesion? _yo;
    private IReadOnlyList<UsuarioVista> _usuarios = [];
    private IReadOnlyList<Oficina> _oficinas = [];
    private DatosUsuario _datos = new();
    private int? _idEdicion;
    private bool _editando;
    private string _filtro = "";
    private string? _mensaje;
    private string _claseMensaje = "alert-success";

    private IEnumerable<UsuarioVista> Filtrados => string.IsNullOrWhiteSpace(_filtro)
        ? _usuarios
        : _usuarios.Where(u => u.NombreCompleto.Contains(_filtro, StringComparison.OrdinalIgnoreCase) || u.Correo.Contains(_filtro, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        _yo = await Estado.UsuarioAsync();
        _oficinas = Catalogos.Oficinas();
        Cargar();
    }

    private void Cargar() => _usuarios = Servicio.Listar();

    private void Nuevo()
    {
        _datos = new DatosUsuario { Rol = Roles.Ingeniero };
        _idEdicion = null;
        _editando = true;
        _mensaje = null;
    }

    private void Editar(UsuarioVista u)
    {
        _datos = new DatosUsuario { Correo = u.Correo, NombreCompleto = u.NombreCompleto, Rol = u.Rol, IdOficina = u.IdOficina };
        _idEdicion = u.Id;
        _editando = true;
        _mensaje = null;
    }

    private void Guardar()
    {
        try
        {
            if (_idEdicion is null) Servicio.Crear(_datos, _yo!.Id);
            else Servicio.Editar(_idEdicion.Value, _datos, _yo!.Id);
            Mensaje($"Usuario {_datos.Correo.Trim().ToLowerInvariant()} guardado.", "alert-success");
            _editando = false;
            Cargar();
        }
        catch (ErrorNegocio ex) { Mensaje(ex.Message, "alert-danger"); }
    }

    private void CambiarEstado(UsuarioVista u)
    {
        try
        {
            Servicio.CambiarEstado(u.Id, !u.Activo, _yo!.Id);
            Mensaje($"{u.NombreCompleto} quedó {(u.Activo ? "deshabilitado" : "habilitado")}.", "alert-success");
            Cargar();
        }
        catch (ErrorNegocio ex) { Mensaje(ex.Message, "alert-danger"); }
    }

    private void Mensaje(string m, string clase) { _mensaje = m; _claseMensaje = clase; }
}
