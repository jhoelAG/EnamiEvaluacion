@* Fila de una lista de barras (ranking o medidor): nombre y valor arriba, barra proporcional (0 a 100) abajo.
   La pista es un tono suave del mismo color; el extremo de la barra es redondeado. *@
<div class="mb-2" title="@Etiqueta: @Texto">
    <div class="d-flex justify-content-between gap-2 small">
        <span class="text-truncate">@Etiqueta</span>
        <span class="text-nowrap fw-semibold">@Texto</span>
    </div>
    <div style="height:8px;border-radius:4px;background:@Pista">
        <div style="height:8px;border-radius:4px;background:@Color;width:@(Graficos.N(Math.Clamp(Ancho, Ancho > 0 ? 1.5 : 0, 100)))%"></div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Etiqueta { get; set; } = "";
    [Parameter, EditorRequired] public double Ancho { get; set; }
    [Parameter] public string Texto { get; set; } = "";
    [Parameter] public string Color { get; set; } = Graficos.Turquesa;
    [Parameter] public string Pista { get; set; } = Graficos.TurquesaSuave;
}
