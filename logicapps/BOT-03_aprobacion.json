{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "$connections": {
        "type": "Object",
        "defaultValue": {}
      },
      "claveApi": {
        "type": "SecureString",
        "defaultValue": ""
      },
      "correoPruebas": {
        "type": "String",
        "defaultValue": ""
      }
    },
    "triggers": {
      "Aviso_de_la_aplicacion": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "method": "POST",
          "schema": {
            "type": "object",
            "properties": {
              "tipo": {
                "type": "string"
              },
              "idEvaluacion": {
                "type": "integer"
              },
              "nroEvaluacion": {
                "type": "string"
              },
              "nivel": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "nivelNombre": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "aprobador": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "nombre": {
                    "type": "string"
                  },
                  "correo": {
                    "type": "string"
                  }
                }
              },
              "ingeniero": {
                "type": "object",
                "properties": {
                  "nombre": {
                    "type": "string"
                  },
                  "correo": {
                    "type": "string"
                  }
                }
              },
              "productor": {
                "type": "string"
              },
              "faena": {
                "type": "string"
              },
              "oficina": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "instrumento": {
                "type": "string"
              },
              "montoSolicitado": {
                "type": "number"
              },
              "van": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "estado": {
                "type": "string"
              },
              "comentario": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "urlEvaluacion": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "urlDecision": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "tipo",
              "idEvaluacion",
              "nroEvaluacion",
              "ingeniero"
            ]
          }
        }
      }
    },
    "actions": {
      "Segun_el_tipo_de_aviso": {
        "type": "Switch",
        "expression": "@triggerBody()?['tipo']",
        "cases": {
          "Aprobacion_pendiente": {
            "case": "APROBACION_PENDIENTE",
            "actions": {
              "Enviar_correo_de_aprobacion": {
                "type": "ApiConnectionWebhook",
                "inputs": {
                  "host": {
                    "connection": {
                      "name": "@parameters('$connections')['outlook']['connectionId']"
                    }
                  },
                  "path": "/approvalmail/$subscriptions",
                  "body": {
                    "NotificationUrl": "@{listCallbackUrl()}",
                    "Message": {
                      "To": "@{if(empty(parameters('correoPruebas')), triggerBody()?['aprobador']?['correo'], parameters('correoPruebas'))}",
                      "Subject": "Aprobación pendiente: @{triggerBody()?['nroEvaluacion']} (@{triggerBody()?['nivelNombre']})",
                      "Options": "Aprobar, Observar",
                      "Body": "<div style=\"font-family:Segoe UI,Arial,sans-serif;font-size:14px;color:#222\">@{if(empty(parameters('correoPruebas')), '', concat('<p style=\"background:#fff4ce;padding:8px;border-radius:4px\"><b>Piloto:</b> este correo era para ', triggerBody()?['aprobador']?['nombre'], ' &lt;', triggerBody()?['aprobador']?['correo'], '&gt;.</p>'))}<p>La evaluación <b>@{triggerBody()?['nroEvaluacion']}</b> espera su decisión como <b>@{triggerBody()?['nivelNombre']}</b>.</p><table style=\"border-collapse:collapse;margin:8px 0\"><tr><td style=\"padding:4px 12px 4px 0;color:#555\">Productor</td><td style=\"padding:4px 0\"><b>@{triggerBody()?['productor']}</b></td></tr><tr><td style=\"padding:4px 12px 4px 0;color:#555\">Faena</td><td style=\"padding:4px 0\"><b>@{triggerBody()?['faena']}</b></td></tr><tr><td style=\"padding:4px 12px 4px 0;color:#555\">Oficina</td><td style=\"padding:4px 0\"><b>@{triggerBody()?['oficina']}</b></td></tr><tr><td style=\"padding:4px 12px 4px 0;color:#555\">Instrumento</td><td style=\"padding:4px 0\"><b>@{triggerBody()?['instrumento']}</b></td></tr><tr><td style=\"padding:4px 12px 4px 0;color:#555\">Monto solicitado</td><td style=\"padding:4px 0\"><b>US$ @{formatNumber(triggerBody()?['montoSolicitado'], 'N0', 'es-CL')}</b></td></tr><tr><td style=\"padding:4px 12px 4px 0;color:#555\">VAN</td><td style=\"padding:4px 0\"><b>$ @{if(equals(triggerBody()?['van'], null), 'sin cálculo', formatNumber(triggerBody()?['van'], 'N0', 'es-CL'))}</b></td></tr><tr><td style=\"padding:4px 12px 4px 0;color:#555\">Comentario</td><td style=\"padding:4px 0\"><b>@{coalesce(triggerBody()?['comentario'], '—')}</b></td></tr></table><p><a href=\"@{triggerBody()?['urlEvaluacion']}\">Ver la evaluación en la aplicación</a></p><p>Elija <b>Aprobar</b> u <b>Observar</b>. Para <b>rechazar</b>, ingrese a la aplicación: el rechazo exige elegir la causal.</p></div>",
                      "Importance": "Normal",
                      "HideHTMLMessage": false,
                      "ShowHTMLConfirmationDialog": false
                    }
                  }
                },
                "runAfter": {}
              },
              "Registrar_decision_en_la_API": {
                "type": "Http",
                "inputs": {
                  "method": "POST",
                  "uri": "@{triggerBody()?['urlDecision']}",
                  "headers": {
                    "Content-Type": "application/json",
                    "X-Api-Key": "@parameters('claveApi')"
                  },
                  "body": {
                    "correo": "@{triggerBody()?['aprobador']?['correo']}",
                    "decision": "@{body('Enviar_correo_de_aprobacion')?['SelectedOption']}",
                    "comentario": "@{if(equals(body('Enviar_correo_de_aprobacion')?['SelectedOption'], 'Observar'), 'Observada desde el correo de aprobación: el aprobador indicará qué corregir.', 'Aprobada desde el correo de aprobación.')}"
                  }
                },
                "runAfter": {
                  "Enviar_correo_de_aprobacion": [
                    "Succeeded"
                  ]
                }
              }
            }
          },
          "Observada": {
            "case": "OBSERVADA",
            "actions": {
              "Avisar_al_ingeniero_la_observacion": {
                "type": "ApiConnection",
                "inputs": {
                  "host": {
                    "connection": {
                      "name": "@parameters('$connections')['outlook']['connectionId']"
                    }
                  },
                  "method": "post",
                  "path": "/v2/Mail",
                  "body": {
                    "To": "@{if(empty(parameters('correoPruebas')), triggerBody()?['ingeniero']?['correo'], parameters('correoPruebas'))}",
                    "Subject": "Evaluación observada: @{triggerBody()?['nroEvaluacion']}",
                    "Body": "<div style=\"font-family:Segoe UI,Arial,sans-serif;font-size:14px;color:#222\">@{if(empty(parameters('correoPruebas')), '', concat('<p style=\"background:#fff4ce;padding:8px;border-radius:4px\"><b>Piloto:</b> este correo era para ', triggerBody()?['ingeniero']?['nombre'], ' &lt;', triggerBody()?['ingeniero']?['correo'], '&gt;.</p>'))}<p>La evaluación <b>@{triggerBody()?['nroEvaluacion']}</b> fue <b>observada</b> y volvió a usted para corregirla.</p><table style=\"border-collapse:collapse;margin:8px 0\"><tr><td style=\"padding:4px 12px 4px 0;color:#555\">Productor</td><td style=\"padding:4px 0\"><b>@{triggerBody()?['productor']}</b></td></tr><tr><td style=\"padding:4px 12px 4px 0;color:#555\">Faena</td><td style=\"padding:4px 0\"><b>@{triggerBody()?['faena']}</b></td></tr><tr><td style=\"padding:4px 12px 4px 0;color:#555\">Oficina</td><td style=\"padding:4px 0\"><b>@{triggerBody()?['oficina']}</b></td></tr><tr><td style=\"padding:4px 12px 4px 0;color:#555\">Instrumento</td><td style=\"padding:4px 0\"><b>@{triggerBody()?['instrumento']}</b></td></tr><tr><td style=\"padding:4px 12px 4px 0;color:#555\">Monto solicitado</td><td style=\"padding:4px 0\"><b>US$ @{formatNumber(triggerBody()?['montoSolicitado'], 'N0', 'es-CL')}</b></td></tr><tr><td style=\"padding:4px 12px 4px 0;color:#555\">VAN</td><td style=\"padding:4px 0\"><b>$ @{if(equals(triggerBody()?['van'], null), 'sin cálculo', formatNumber(triggerBody()?['van'], 'N0', 'es-CL'))}</b></td></tr><tr><td style=\"padding:4px 12px 4px 0;color:#555\">Comentario</td><td style=\"padding:4px 0\"><b>@{coalesce(triggerBody()?['comentario'], '—')}</b></td></tr></table><p><a href=\"@{triggerBody()?['urlEvaluacion']}\">Corregir la evaluación</a></p></div>",
                    "Importance": "Normal"
                  }
                }
              }
            }
          },
          "Dictamen": {
            "case": "DICTAMEN",
            "actions": {
              "Avisar_al_ingeniero_el_dictamen": {
                "type": "ApiConnection",
                "inputs": {
                  "host": {
                    "connection": {
                      "name": "@parameters('$connections')['outlook']['connectionId']"
                    }
                  },
                  "method": "post",
                  "path": "/v2/Mail",
                  "body": {
                    "To": "@{if(empty(parameters('correoPruebas')), triggerBody()?['ingeniero']?['correo'], parameters('correoPruebas'))}",
                    "Subject": "Dictamen: @{triggerBody()?['nroEvaluacion']} @{toLower(triggerBody()?['estado'])}",
                    "Body": "<div style=\"font-family:Segoe UI,Arial,sans-serif;font-size:14px;color:#222\">@{if(empty(parameters('correoPruebas')), '', concat('<p style=\"background:#fff4ce;padding:8px;border-radius:4px\"><b>Piloto:</b> este correo era para ', triggerBody()?['ingeniero']?['nombre'], ' &lt;', triggerBody()?['ingeniero']?['correo'], '&gt;.</p>'))}<p>La evaluación <b>@{triggerBody()?['nroEvaluacion']}</b> terminó con estado <b>@{triggerBody()?['estado']}</b>.</p><table style=\"border-collapse:collapse;margin:8px 0\"><tr><td style=\"padding:4px 12px 4px 0;color:#555\">Productor</td><td style=\"padding:4px 0\"><b>@{triggerBody()?['productor']}</b></td></tr><tr><td style=\"padding:4px 12px 4px 0;color:#555\">Faena</td><td style=\"padding:4px 0\"><b>@{triggerBody()?['faena']}</b></td></tr><tr><td style=\"padding:4px 12px 4px 0;color:#555\">Oficina</td><td style=\"padding:4px 0\"><b>@{triggerBody()?['oficina']}</b></td></tr><tr><td style=\"padding:4px 12px 4px 0;color:#555\">Instrumento</td><td style=\"padding:4px 0\"><b>@{triggerBody()?['instrumento']}</b></td></tr><tr><td style=\"padding:4px 12px 4px 0;color:#555\">Monto solicitado</td><td style=\"padding:4px 0\"><b>US$ @{formatNumber(triggerBody()?['montoSolicitado'], 'N0', 'es-CL')}</b></td></tr><tr><td style=\"padding:4px 12px 4px 0;color:#555\">VAN</td><td style=\"padding:4px 0\"><b>$ @{if(equals(triggerBody()?['van'], null), 'sin cálculo', formatNumber(triggerBody()?['van'], 'N0', 'es-CL'))}</b></td></tr><tr><td style=\"padding:4px 12px 4px 0;color:#555\">Comentario</td><td style=\"padding:4px 0\"><b>@{coalesce(triggerBody()?['comentario'], '—')}</b></td></tr></table><p><a href=\"@{triggerBody()?['urlEvaluacion']}\">Ver la evaluación</a></p></div>",
                    "Importance": "Normal"
                  }
                }
              }
            }
          }
        },
        "default": {
          "actions": {}
        },
        "runAfter": {}
      }
    },
    "outputs": {}
  },
  "parameters": {}
}
