{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "$connections": {
        "type": "Object",
        "defaultValue": {}
      },
      "urlApi": {
        "type": "String",
        "defaultValue": ""
      },
      "claveApi": {
        "type": "SecureString",
        "defaultValue": ""
      },
      "correoAlertas": {
        "type": "String",
        "defaultValue": ""
      },
      "probarAlerta": {
        "type": "Bool",
        "defaultValue": false
      }
    },
    "triggers": {
      "Todos_los_dias_a_las_9": {
        "type": "Recurrence",
        "recurrence": {
          "frequency": "Day",
          "interval": 1,
          "timeZone": "Pacific SA Standard Time",
          "schedule": {
            "hours": [
              "9"
            ],
            "minutes": [
              0
            ]
          }
        }
      }
    },
    "actions": {
      "Consultar_mindicador": {
        "type": "Http",
        "inputs": {
          "method": "GET",
          "uri": "https://mindicador.cl/api"
        },
        "runAfter": {}
      },
      "Dolar_registrar_bcch": {
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "@{parameters('urlApi')}/api/bancocentral/Dolar",
          "headers": {
            "X-Api-Key": "@parameters('claveApi')"
          }
        },
        "runAfter": {
          "Consultar_mindicador": [
            "Succeeded",
            "Failed",
            "Skipped",
            "TimedOut"
          ]
        }
      },
      "Cobre_registrar_bcch": {
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "@{parameters('urlApi')}/api/bancocentral/PrecioCuLb",
          "headers": {
            "X-Api-Key": "@parameters('claveApi')"
          }
        },
        "runAfter": {
          "Consultar_mindicador": [
            "Succeeded",
            "Failed",
            "Skipped",
            "TimedOut"
          ]
        }
      },
      "Oro_registrar_bcch": {
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "@{parameters('urlApi')}/api/bancocentral/PrecioAu",
          "headers": {
            "X-Api-Key": "@parameters('claveApi')"
          }
        },
        "runAfter": {
          "Consultar_mindicador": [
            "Succeeded",
            "Failed",
            "Skipped",
            "TimedOut"
          ]
        }
      },
      "Plata_registrar_bcch": {
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "@{parameters('urlApi')}/api/bancocentral/PrecioAg",
          "headers": {
            "X-Api-Key": "@parameters('claveApi')"
          }
        },
        "runAfter": {
          "Consultar_mindicador": [
            "Succeeded",
            "Failed",
            "Skipped",
            "TimedOut"
          ]
        }
      },
      "Dolar_registrar_respaldo": {
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "@{parameters('urlApi')}/api/variables/Dolar",
          "headers": {
            "Content-Type": "application/json",
            "X-Api-Key": "@parameters('claveApi')"
          },
          "body": {
            "valor": "@body('Consultar_mindicador')?['dolar']?['valor']",
            "fuente": "API_BCCH"
          }
        },
        "runAfter": {
          "Dolar_registrar_bcch": [
            "Failed",
            "Skipped",
            "TimedOut"
          ]
        }
      },
      "Cobre_registrar_respaldo": {
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "@{parameters('urlApi')}/api/variables/PrecioCuLb",
          "headers": {
            "Content-Type": "application/json",
            "X-Api-Key": "@parameters('claveApi')"
          },
          "body": {
            "valor": "@body('Consultar_mindicador')?['libra_cobre']?['valor']",
            "fuente": "RPA_COCHILCO"
          }
        },
        "runAfter": {
          "Cobre_registrar_bcch": [
            "Failed",
            "Skipped",
            "TimedOut"
          ]
        }
      },
      "Revisar_resultados": {
        "type": "Compose",
        "inputs": "@concat(if(parameters('probarAlerta'), 'Prueba de alerta (simulada); ', ''), if(or(equals(actions('Dolar_registrar_bcch')?['status'], 'Succeeded'), equals(actions('Dolar_registrar_bcch')?['outputs']?['statusCode'], 409), equals(actions('Dolar_registrar_respaldo')?['status'], 'Succeeded'), equals(actions('Dolar_registrar_respaldo')?['outputs']?['statusCode'], 409)), '', 'Dólar observado; '), if(or(equals(actions('Cobre_registrar_bcch')?['status'], 'Succeeded'), equals(actions('Cobre_registrar_bcch')?['outputs']?['statusCode'], 409), equals(actions('Cobre_registrar_respaldo')?['status'], 'Succeeded'), equals(actions('Cobre_registrar_respaldo')?['outputs']?['statusCode'], 409)), '', 'Precio del cobre; '), if(or(equals(actions('Oro_registrar_bcch')?['status'], 'Succeeded'), equals(actions('Oro_registrar_bcch')?['outputs']?['statusCode'], 409)), '', 'Precio del oro; '), if(or(equals(actions('Plata_registrar_bcch')?['status'], 'Succeeded'), equals(actions('Plata_registrar_bcch')?['outputs']?['statusCode'], 409)), '', 'Precio de la plata; '))",
        "runAfter": {
          "Dolar_registrar_respaldo": [
            "Succeeded",
            "Failed",
            "Skipped",
            "TimedOut"
          ],
          "Cobre_registrar_respaldo": [
            "Succeeded",
            "Failed",
            "Skipped",
            "TimedOut"
          ],
          "Oro_registrar_bcch": [
            "Succeeded",
            "Failed",
            "Skipped",
            "TimedOut"
          ],
          "Plata_registrar_bcch": [
            "Succeeded",
            "Failed",
            "Skipped",
            "TimedOut"
          ]
        }
      },
      "Si_hubo_fallas": {
        "type": "If",
        "expression": {
          "not": [
            {
              "equals": [
                "@outputs('Revisar_resultados')",
                ""
              ]
            }
          ]
        },
        "runAfter": {
          "Revisar_resultados": [
            "Succeeded"
          ]
        },
        "actions": {
          "Registrar_incidencia_en_la_auditoria": {
            "type": "Http",
            "inputs": {
              "method": "POST",
              "uri": "@{parameters('urlApi')}/api/robots/incidencias",
              "headers": {
                "Content-Type": "application/json",
                "X-Api-Key": "@parameters('claveApi')"
              },
              "body": {
                "robot": "BOT-01",
                "detalle": "@{concat('No se pudo actualizar con ninguna fuente: ', outputs('Revisar_resultados'), 'se mantiene el valor vigente.')}"
              }
            },
            "runAfter": {}
          },
          "Avisar_al_administrador": {
            "type": "ApiConnection",
            "inputs": {
              "host": {
                "connection": {
                  "name": "@parameters('$connections')['outlook']['connectionId']"
                }
              },
              "method": "post",
              "path": "/v2/Mail",
              "body": {
                "To": "@parameters('correoAlertas')",
                "Subject": "BOT-01: no se pudieron actualizar valores de mercado",
                "Body": "<div style=\"font-family:Segoe UI,Arial,sans-serif;font-size:14px\"><p>El robot BOT-01 no pudo actualizar, ni con la API del Banco Central de Chile ni con su respaldo:</p><p><b>@{outputs('Revisar_resultados')}</b></p><p>La plataforma mantiene el último valor registrado. Revise «Dólar y minerales» y, si hace falta, ingrese el valor a mano.</p><p>El detalle de la ejecución está en el historial del flujo bot01-mercado en Azure.</p></div>",
                "Importance": "High"
              }
            },
            "runAfter": {}
          }
        },
        "else": {
          "actions": {}
        }
      }
    },
    "outputs": {}
  },
  "parameters": {}
}